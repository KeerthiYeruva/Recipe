    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.98.0",
    "sharp": "0.35.3",
    "slugify": "^1.6.8",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "tsx": "^4.7.0",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "overrides": {
