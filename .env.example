# Database Configuration
# For SQLite (local development only):
# DATABASE_PATH=./meals.db

# For Vercel Postgres (recommended for production):
# Get this from Vercel Storage → Postgres → Connection String
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# Deployment Detection
# Set automatically by Vercel during deployment.
# When true, some features (like recipe persistence) may be disabled due to ephemeral file systems.
# VERCEL=true

# SEO & Site URLs
# Base URL for the site, used in robots.txt and sitemap.xml metadata exports.
# Defaults to http://localhost:3000 in development.
# NEXT_PUBLIC_SITE_URL=https://recipes.example.com

# Image Storage (if using Vercel Blob instead of public/images)
# Get this from Vercel Storage → Blob → Token
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
